<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates the reference vectors internal/fm is pinned to, from the published
       M0LTE.FmChannel package. Run from this directory: "dotnet run -c Release" (writes ../../internal/fm/testdata). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="M0LTE.FmChannel" Version="0.7.0" />
  </ItemGroup>
</Project>
